{
  "_comment": "The WireMock subset hosted mocks support. Read by relay/worker (mockmatch.ts, mocktemplate.ts tests) and crates/devall-relay (hosted_mock.rs) so the publish check and the edge agree.",
  "version": 1,
  "mappingKeys": [
    "id",
    "uuid",
    "name",
    "request",
    "response",
    "priority",
    "scenarioName",
    "requiredScenarioState",
    "newScenarioState",
    "metadata",
    "persistent",
    "insertionIndex",
    "postServeActions",
    "serveEventListeners"
  ],
  "requestKeys": [
    "method",
    "url",
    "urlPath",
    "urlPattern",
    "urlPathPattern",
    "urlPathTemplate",
    "queryParameters",
    "headers",
    "cookies",
    "formParameters",
    "bodyPatterns",
    "basicAuthCredentials",
    "host",
    "pathParameters"
  ],
  "responseKeys": [
    "status",
    "statusMessage",
    "headers",
    "body",
    "jsonBody",
    "base64Body",
    "bodyFileName",
    "fixedDelayMilliseconds",
    "delayDistribution",
    "transformers",
    "transformerParameters",
    "additionalProxyRequestHeaders"
  ],
  "matchers": [
    "equalTo",
    "contains",
    "doesNotContain",
    "matches",
    "doesNotMatch",
    "absent",
    "anything",
    "equalToJson",
    "matchesJsonPath",
    "binaryEqualTo",
    "and",
    "or",
    "not"
  ],
  "matcherOptions": [
    "caseInsensitive",
    "ignoreArrayOrder",
    "ignoreExtraElements",
    "enablePlaceholders"
  ],
  "delayDistributions": [
    "fixed",
    "uniform",
    "lognormal"
  ],
  "helpers": [
    "abbreviate",
    "and",
    "array",
    "base64",
    "capitalize",
    "capitalizeFirst",
    "contains",
    "default",
    "defaultIfEmpty",
    "each",
    "eq",
    "formatJson",
    "gt",
    "gte",
    "if",
    "join",
    "jsonPath",
    "lower",
    "lt",
    "lte",
    "matches",
    "math",
    "ne",
    "neq",
    "not",
    "now",
    "or",
    "pickRandom",
    "random",
    "randomDecimal",
    "randomInt",
    "randomValue",
    "range",
    "replace",
    "size",
    "substring",
    "toJson",
    "trim",
    "unless",
    "upper",
    "urlEncode",
    "with"
  ],
  "maxDelayMs": 10000,
  "maxUploadFileBytes": 262144
}
