{
  "info": {
    "_postman_id": "8c5a3d4e-1f2b-4c6d-9e8f-0a1b2c3d4e5f",
    "name": "Acme Store API",
    "description": "Public API of the Acme store.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "1234567"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": { "type": "text/javascript", "exec": ["console.log('collection pre-request');"] }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "https://api.acme.test/v1", "type": "string" },
    { "key": "apiKey", "value": "ak_live_51Habcdef0123456789", "type": "string" },
    { "key": "unused", "value": "x", "disabled": true }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.environment.set(\"accessToken\", jsonData.access_token);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "description": "Exchanges credentials for an access token."
          },
          "response": []
        },
        {
          "name": "Login (form)",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "admin", "type": "string" },
                { "key": "password", "value": "S3cr3t!pass", "type": "string" }
              ]
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "grant_type", "value": "password", "type": "text" },
                { "key": "scope", "value": "read write", "type": "text", "disabled": true }
              ]
            },
            "url": "{{baseUrl}}/oauth/token"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Products",
      "auth": {
        "type": "apikey",
        "apikey": [
          { "key": "key", "value": "X-API-Key", "type": "string" },
          { "key": "value", "value": "{{apiKey}}", "type": "string" },
          { "key": "in", "value": "header", "type": "string" }
        ]
      },
      "item": [
        {
          "name": "Reviews",
          "item": [
            {
              "name": "List reviews",
              "request": {
                "method": "GET",
                "header": [{ "key": "Accept", "value": "application/json" }],
                "url": {
                  "raw": "{{baseUrl}}/products/:productId/reviews?page=1&sort=-created",
                  "host": ["{{baseUrl}}"],
                  "path": ["products", ":productId", "reviews"],
                  "query": [
                    { "key": "page", "value": "1" },
                    { "key": "sort", "value": "-created", "disabled": true }
                  ],
                  "variable": [{ "key": "productId", "value": "42" }]
                }
              },
              "response": []
            }
          ]
        },
        {
          "name": "Upload product image",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "image", "type": "file", "src": "/Users/jane/Pictures/shoe.png" },
                { "key": "alt", "value": "Red shoe", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/products/:productId/images",
              "host": ["{{baseUrl}}"],
              "path": ["products", ":productId", "images"],
              "variable": [{ "key": "productId", "value": "42" }]
            }
          },
          "response": []
        },
        {
          "name": "Search products (GraphQL)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query Search($q: String!) {\n  products(q: $q) { id name }\n}",
                "variables": "{\"q\": \"shoe\"}"
              }
            },
            "url": { "raw": "{{baseUrl}}/graphql", "host": ["{{baseUrl}}"], "path": ["graphql"] }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Health check",
      "protocolProfileBehavior": { "followRedirects": false },
      "request": {
        "auth": { "type": "noauth" },
        "method": "GET",
        "header": [],
        "url": { "raw": "https://status.acme.test/health", "protocol": "https", "host": ["status", "acme", "test"], "path": ["health"] }
      },
      "response": []
    },
    {
      "name": "Signed S3 upload",
      "request": {
        "auth": {
          "type": "awsv4",
          "awsv4": [
            { "key": "accessKey", "value": "AKIAIOSFODNN7EXAMPLE", "type": "string" },
            { "key": "secretKey", "value": "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY", "type": "string" },
            { "key": "region", "value": "eu-west-1", "type": "string" },
            { "key": "service", "value": "s3", "type": "string" }
          ]
        },
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "text/plain" }],
        "body": { "mode": "raw", "raw": "hello" },
        "url": "https://acme-bucket.s3.eu-west-1.amazonaws.com/hello.txt"
      },
      "response": []
    },
    {
      "name": "Legacy NTLM endpoint",
      "request": {
        "auth": {
          "type": "ntlm",
          "ntlm": [
            { "key": "username", "value": "CORP\\svc-legacy", "type": "string" },
            { "key": "password", "value": "Legacy#Pass1", "type": "string" },
            { "key": "workstation", "value": "BUILD-01", "type": "string" }
          ]
        },
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/legacy"
      },
      "response": []
    }
  ]
}
