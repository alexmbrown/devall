# Users API — JetBrains HTTP Client / VS Code REST Client
@apiVersion = v2
@contentType = application/json

### List users
# Returns a page of users.
GET {{host}}/{{apiVersion}}/users?page=1
    &limit=25
Accept: {{contentType}}
Authorization: Bearer {{token}}

### Create user
# @name createUser
POST {{host}}/{{apiVersion}}/users HTTP/1.1
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{
  "id": "{{$uuid}}",
  "name": "Ada Lovelace",
  "createdAt": "{{$isoTimestamp}}"
}

> {%
  client.test("created", function () {
    client.assert(response.status === 201, "status");
  });
  client.global.set("userId", response.body.id);
%}

### Update avatar
# @no-redirect
# @timeout 15
PUT {{host}}/{{apiVersion}}/users/42/avatar
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="avatar"; filename="ada.png"
Content-Type: image/png

< ./images/ada.png
--WebAppBoundary
Content-Disposition: form-data; name="crop"

square
--WebAppBoundary--

### Login (form)
POST {{host}}/login
Content-Type: application/x-www-form-urlencoded

username=ada
&password={{$dotenv ADMIN_PASSWORD}}

### Import CSV
POST {{host}}/{{apiVersion}}/users/import
Content-Type: text/csv

< ./data/users.csv

### Me (GraphQL)
GRAPHQL {{host}}/graphql
Authorization: Bearer {{token}}

query Me {
  me { id name }
}

{"withPosts": false}
